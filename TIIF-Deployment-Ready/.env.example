# Copy to .env.local locally, or configure these in your hosting provider.
# Do not commit .env.local, service-account JSON files, or real API secrets.

# Firebase Web App configuration (public values; protect the project with rules).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-only JSON string; never prefix with NEXT_PUBLIC_).
# Production (Vercel): paste the service-account JSON into this secret variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local-only bootstrap script path; do not set this in Vercel.
FIREBASE_SERVICE_ACCOUNT_PATH=

# OpenAI (server-only).
OPENAI_API_KEY=

# LiveKit (server-only keys + public endpoint).
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stripe (server-only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_THERAPIST_PRO=
STRIPE_PRICE_SCHOOL=
STRIPE_PRICE_UNIVERSITY=

# Application URLs.
NEXT_PUBLIC_APP_NAME=TIIF
NEXT_PUBLIC_APP_URL=http://localhost:3000
